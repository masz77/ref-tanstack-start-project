{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fitality-clubs",
  // why: Workers Cache's real precondition is Wrangler >= 4.69.0, NOT a newer
  // compatibility_date — CF docs confirm no minimum date for the feature.
  // 2026-07-08: reverted compatibility_date 2026-05-01 -> 2025-10-08; the compat bump
  // was unnecessary (the Wrangler version is the actual gate).
  "compatibility_date": "2025-10-08",
  "main": "@tanstack/react-start/server-entry",
  "upload_source_maps": true,
  "compatibility_flags": ["nodejs_compat"],
  // why: enables Workers Cache — reads the standard Cache-Control headers we emit, no code coupling.
  "cache": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "REPLACE_WITH_YOUR_D1_ID",
      // 2026-10-22: was "src/db/migrations" (wrong); the real folder is src/server/infrastructure/db/migrations.
      "migrations_dir": "src/server/infrastructure/db/migrations",
      "database_name": "fitality-clubs-db"
    }
  ],
  // "kv_namespaces": [
  //   {
  //     "binding": "KV_BINDING",
  //     "id": "REPLACE_WITH_YOUR_KV_ID"
  //   }
  // ],
  "observability": {
    "enabled": true,
    // 2026-07-02: enable native Workers tracing (open beta) — auto-instruments D1/KV/Queue/fetch.
    // why: OTel-compliant spans with zero code changes; note: billed on all plans since 2026-03-01
    "traces": {
      "enabled": true
    }
  },
  "placement": {
    "mode": "smart"
  }
}
